;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a point-of-sale-assist robot performs physical
;; bagging, receipt printing and till-drawer handling. Declared here: a
;; filled shopping bag lifted from the bagging well onto the customer side
;; of the counter, and the till drawer carried from the checkout to the back
;; office safe at shift change.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5230"
 :cases
 [{:id :bag-to-customer-counter
   :kind :manipulator
   :procedure "arm lifts a filled shopping bag from the bagging well onto the customer side of the counter"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 4.5 :m2-kg 3.0
            :from [0.40 -0.20] :to [0.75 0.10] :duration-s 1.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 3.0 5.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 90.0 :basis "estimate: continuous shoulder torque of a ~10 kg-payload collaborative arm"}
   :boundary {:lo 0.2 :hi 30.0}}
  {:id :till-drawer-to-safe
   :kind :transport
   :procedure "robot carries the till drawer from the checkout to the back-office safe at shift change"
   :params {:mass-kg 35.0 :payload-kg 6.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 80.0 :crr 0.015
            :cog-height-m 0.55 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [8.0 15.0 25.0 40.0 60.0]}
   :quantity :cycle-time-s
   :limit {:max 45.0 :basis "estimate: the drawer is out of the till and unaccounted for no longer than 45 s at shift change"}
   :boundary {:lo 2.0 :hi 150.0}}]}
